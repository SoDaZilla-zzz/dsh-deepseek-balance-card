{
  "name": "dsh-liquid-glass-balance-card",
  "version": "0.2.0",
  "description": "DeepSeek Harness (DSH) web GUI plugin: a draggable liquid-glass floating card showing DeepSeek API balance, cumulative spend and token usage in the top-right corner.",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "author": "sooodaaa",
  "repository": {
    "type": "git",
    "url": "https://github.com/SoDaZilla-zzz/dsh-liquid-glass-balance-card.git"
  },
  "bugs": {
    "url": "https://github.com/SoDaZilla-zzz/dsh-liquid-glass-balance-card/issues"
  },
  "homepage": "https://github.com/SoDaZilla-zzz/dsh-liquid-glass-balance-card",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-cordis-client-runner",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "plugin",
    "balance",
    "quota",
    "liquid-glass",
    "draggable"
  ],
  "license": "MIT"
}
